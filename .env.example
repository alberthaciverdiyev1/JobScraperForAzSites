PORT=3000
HOST=127.0.0.1
SCRAPE_TIMEOUT_MS=15000
CORE_CACHE_REFRESH_MS=300000

# Scraper ağ davranışı (hepsi opsiyonel; varsayılanlar nazik/gerçekçi)
SCRAPE_REQUEST_INTERVAL_MS=150
SCRAPE_MAX_RETRIES=2
SCRAPE_RETRY_BASE_MS=15000
# boss.az istekleri gün boyuna yayılsın (yavaş süpürme)
SCRAPE_INTERVAL_BOSS_MS=60000
# boss 403'te uzun bekleyip gün boyu tekrar dener (blok açılınca yakalar)
SCRAPE_RETRY_BASE_BOSS_MS=300000
SCRAPE_MAX_RETRIES_BOSS=8
# Tüm liste isteklerini proxy üzerinden gönder (IP bloğunu aşmak için). Örn: http://user:pass@host:port
# Tüm kaynaklar için global proxy:
# SCRAPE_PROXY_URL=
# Yalnız boss.az için proxy (önerilir): http://user:pass@host:port
# SCRAPE_PROXY_URL_BOSS=
# Boşsa gerçekçi bir tarayıcı User-Agent kullanılır.
# SCRAPE_USER_AGENT=

# Şirket logoları yerel indirilir; uzak URL ile istek yapılmaz.
# COMPANY_LOGO_DIR=data/company-logos
# COMPANY_LOGO_URL_BASE=/storage/company-logos
# COMPANY_LOGO_MAX_BYTES=2000000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jobing
DB_USERNAME=admin
DB_PASSWORD=secret
